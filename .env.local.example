# Openhouse at-apartment · newsletter backend environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
#
# Without these, the newsletter still works on a single device via
# localStorage. Set them to enable cross-device submit → approve.

# ── Supabase ─────────────────────────────────────────────────────────────
# From https://supabase.com → your project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service-role key — SERVER ONLY, never exposed to the browser. Used by the
# /api/newsletters routes to read/write submissions.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Newsletter admin key ─────────────────────────────────────────────────
# A secret the admin types once in /admin/newsletters to review + approve
# submissions. Choose any strong string. Server-only.
NEWSLETTER_ADMIN_KEY=choose-a-strong-secret
